        "applications_source_check": {
          "name": "applications_source_check",
          "value": "\"source\" in ('linkedin', 'jadarat', 'bayt', 'indeed', 'tanqeeb', 'mourjan', 'sabbar', 'company_site', 'whatsapp', 'walk_in', 'referral', 'other')"
        },
        "applications_job_type_check": {
