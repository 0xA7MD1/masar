# Turso (libSQL) database. Leave both empty locally to use file:local.db.
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=

# The single password that unlocks the app.
APP_PASSWORD=

# At least 32 random characters, used to sign the session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Optional: timezone used for "today", streaks and weekly goals (default Asia/Riyadh).
# NEXT_PUBLIC_APP_TIMEZONE=Asia/Riyadh
