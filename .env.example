# Copy to .env and fill in the values. Never commit .env.

# Supabase Postgres: the transaction pooler connection string (port 6543).
DATABASE_URL=

# Clerk (dashboard → API keys).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Guards /api/cron/keepalive. Vercel Cron sends it automatically when set in the project.
CRON_SECRET=

# Only for `pnpm db:import-turso`, the one-time copy of the old data.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: timezone used for "today", streaks and goals (default Asia/Riyadh).
# NEXT_PUBLIC_APP_TIMEZONE=
